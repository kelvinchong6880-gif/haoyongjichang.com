<style>
  .runaway-section {
    margin-top: 100px;
    margin-bottom: 100px;
  }
  .runaway-table-wrapper {
    width: 100%;
    overflow-x: auto;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 20px;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
    position: relative;
  }
  .runaway-table-wrapper::before {
    content: '';
    display: block;
    height: 5px;
    width: 100%;
    background: linear-gradient(90deg, #ef4444 0%, #f59e0b 100%);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
  }
  .runaway-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.95rem;
    text-align: left;
  }
  .runaway-table th, .runaway-table td {
    padding: 18px 24px;
    border-bottom: 1px solid #f3f4f6;
  }
  .runaway-table th {
    background: #fafafa;
    font-weight: 700;
    color: #6b7280;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .runaway-table tr:last-child td {
    border-bottom: none;
  }
  .runaway-table tbody tr {
    transition: background-color 0.2s ease;
  }
  .runaway-table tbody tr:hover {
    background: #f8fafc;
  }
  .runaway-table td strong {
    color: #111827;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .runaway-table td:nth-child(4),
  .runaway-table td:nth-child(5) {
    color: #6b7280;
    font-variant-numeric: tabular-nums;
  }
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1;
  }
  .status-danger {
    background: #fef2f2;
    color: #ef4444;
    border: 1px solid #fecaca;
  }
  .status-danger::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ef4444;
    box-shadow: 0 0 0 2px #fee2e2;
  }
  .status-warning {
    background: #fffbeb;
    color: #f59e0b;
    border: 1px solid #fde68a;
  }
  .status-warning::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #f59e0b;
    box-shadow: 0 0 0 2px #fef3c7;
  }
  .status-bad {
    background: #f3f4f6;
    color: #4b5563;
    border: 1px solid #e5e7eb;
  }
  .status-bad::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #9ca3af;
    box-shadow: 0 0 0 2px #f3f4f6;
  }
</style>

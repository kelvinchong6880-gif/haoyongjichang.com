---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Brand from '../../components/h/Brand.astro';
import AirportCard from '../../components/h/AirportCard.astro';
import Disclosure from '../../components/h/Disclosure.astro';
import { AIRPORTS, bySlug, entry, planPrice, fmtGB, lineLabel, faqSchema, itemListSchema, UPDATED, UPDATED_LABEL, UPDATED_MONTH } from '../../data/airports';

const ok = AIRPORTS.filter((a) => a.streaming && a.ai);
const unknown = AIRPORTS.filter((a) => !(a.streaming && a.ai));
const claims: Record<string, string> = {
  sogo: 'Netflix、Disney+、ChatGPT、TikTok',
  feimao: '原生 IP 解锁 Netflix 等流媒体',
  wuyou: 'ChatGPT、Gemini 等 AI，4K Netflix',
  kuajie: '流媒体和 AI 平台全解锁',
  lingmao: '原生 IP 解锁 Netflix 等流媒体及 AI',
  shanyue: '原生 IP 解锁流媒体，ChatGPT、TikTok',
};
const services = [
  { name: 'ChatGPT / Claude / Gemini', node: '日本、新加坡、美国、台湾', tip: 'OpenAI、Anthropic 和 Google Gemini 都不对中国大陆和香港地区提供服务，用香港节点会提示地区不支持。' },
  { name: 'Netflix', node: '看想看的片在哪个地区上架', tip: '各地区片库不同，日本、美国、新加坡节点片源较多；提示“代理”就换同地区其他节点。' },
  { name: 'Disney+', node: '香港、新加坡、日本、美国', tip: '需要节点所在地区已经上线 Disney+，台湾、香港、新加坡、日本均已上线。' },
  { name: 'YouTube', node: '任意地区', tip: '不挑节点，看 4K 主要看带宽和流量，300GB 以上的套餐更从容。' },
  { name: 'TikTok', node: '美国、新加坡、日本等目标市场', tip: '账号运营最好固定同一地区的独享 IP，频繁换 IP 容易被风控。' },
];
const faq = [
  { q: '哪个机场能稳定用 ChatGPT？', a: `官网写明支持 ChatGPT 的有：${ok.map((a) => a.name).join('、')}。首推 Sogo云（¥25/月 150GB，IPLC + IEPL 双专线）。用的时候选日本、新加坡、美国或台湾节点，不要用香港节点。` },
  { q: '为什么用香港节点打不开 ChatGPT？', a: 'OpenAI 不对中国大陆和香港地区提供服务，香港 IP 会被直接拒绝。换成日本、新加坡、美国、台湾节点即可。Claude 和 Gemini 也是一样。' },
  { q: 'Netflix 提示在使用代理怎么办？', a: '说明当前节点的 IP 被 Netflix 识别了。换同地区的其他节点，或者换一个官网写明支持 Netflix 解锁的机场。' },
  { q: '做 TikTok 运营用哪个机场？', a: '账号运营建议用固定的独享 IP，飞猫云有独享原生 IP 定制套餐（¥550/月 500GB）。只是刷 TikTok 看视频的话，普通专线机场就够。' },
];
const title = `AI与流媒体解锁机场推荐2026：能用ChatGPT、看Netflix的机场`;
const description = `能用ChatGPT、Claude、看Netflix和Disney+的机场推荐（${UPDATED_MONTH}更新）：${ok.length}家官网写明支持AI和流媒体解锁的专线机场，附各服务该选哪个地区节点、香港节点为什么打不开ChatGPT、Netflix提示代理怎么办。`;
const schemas = [itemListSchema(`${UPDATED_MONTH}AI与流媒体解锁机场`, ok), faqSchema(faq)];
---
<BaseLayout title={title} description={description} structuredData={schemas} breadcrumbs={[{ name: 'AI 与流媒体解锁', path: '/ai-streaming/' }]}>
  <div class="h-page">
    <p class="h-eyebrow">更新于 <time datetime={UPDATED}>{UPDATED_LABEL}</time></p>
    <h1>AI 与流媒体解锁：能用 ChatGPT、看 Netflix 的机场推荐</h1>
    <p class="h-lead">想用 ChatGPT、Claude，或者看 Netflix、Disney+，机场要满足两点：<strong>官网写明支持解锁</strong>，以及 <strong>有对应地区的节点</strong>。下面先列出符合条件的机场，再告诉你每个服务该选哪个地区的节点。</p>
    <Disclosure />

    <section class="h-section">
      <h2>官网写明支持 AI 与流媒体的机场（{ok.length} 家）</h2>
      <div class="h-table-wrap">
        <table class="h-table">
          <thead><tr><th scope="col">机场</th><th scope="col">官网写明支持</th><th scope="col">月付起步</th><th scope="col">线路</th><th scope="col">节点地区</th></tr></thead>
          <tbody>
            {ok.map((a, i) => <tr class={i === 0 ? 'is-hl' : ''}><td><Brand a={a} /></td><td style="min-width:200px">{claims[a.slug]}</td><td class="h-num">{planPrice(entry(a)!)} · {fmtGB(entry(a)!.traffic)}</td><td>{lineLabel(a)}</td><td style="min-width:220px">{a.nodeRegions}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p class="h-muted">{unknown.map((a) => a.name).join('、')} 的官网没有写明解锁情况，主要用途是 AI 或流媒体的话，建议优先选上表里的机场。</p>
    </section>

    <section class="h-section">
      <h2>各服务该选哪个地区的节点</h2>
      <div class="h-table-wrap">
        <table class="h-table">
          <thead><tr><th scope="col">服务</th><th scope="col">推荐节点地区</th><th scope="col">注意事项</th></tr></thead>
          <tbody>{services.map((x) => <tr><td><strong>{x.name}</strong></td><td>{x.node}</td><td style="min-width:280px">{x.tip}</td></tr>)}</tbody>
        </table>
      </div>
      <p>详细排查步骤：<a href="/guide/scenario-ai-unblock/">ChatGPT / Claude 访问受限怎么办</a> · <a href="/guide/scenario-streaming-unblock/">Netflix / Disney+ 解锁教程</a></p>
    </section>

    <section class="h-section">
      <h2>首选推荐：Sogo云</h2>
      <p>官网写明支持 Netflix、Disney+、ChatGPT、TikTok，节点覆盖港台日新美等 60 多个，IPLC + IEPL 双专线，用 AI 和看剧都不用频繁换机场。</p>
      <AirportCard a={bySlug('sogo')} rank={1} tag="AI / 流媒体首选" top />
    </section>

    <section class="h-section">
      <h2>AI 与流媒体解锁常见问题</h2>
      {faq.map((f) => <div class="h-qa"><h3>{f.q}</h3><p>{f.a}</p></div>)}
    </section>
  </div>
</BaseLayout>

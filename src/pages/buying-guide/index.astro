---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Brand from '../../components/h/Brand.astro';
import Disclosure from '../../components/h/Disclosure.astro';
import { AIRPORTS, entry, yearly, oneTime, planPrice, fmtGB, lineLabel, isPremium, faqSchema, UPDATED, UPDATED_LABEL, UPDATED_MONTH } from '../../data/airports';

const checklist = [
  { k: '线路', good: 'IPLC / IEPL 专线，官网写清楚', bad: '不写线路，或只写“高速线路”' },
  { k: '价格', good: '月付价清楚，年付有折扣', bad: '首页只写“¥X 起”，点进去全是年付' },
  { k: '流量倍率', good: '全节点 1 倍率', bad: '热门节点 2–3 倍率，实际流量缩水' },
  { k: '付费方式', good: '有月付，能先试一个月', bad: '只卖年付或两三年长期套餐' },
  { k: '解锁', good: '官网写明支持哪些流媒体和 AI', bad: '只写“全解锁”，不说具体服务' },
  { k: '运营', good: '有公告、工单，维护有通知', bad: '没有任何公告渠道，出问题找不到人' },
];
const faq = [
  { q: '新手买机场最容易踩什么坑？', a: '三个：把年付折算价当成月付价；没注意倍率，2 倍节点流量消耗翻倍；一上来就买两三年，结果机场跑路。先月付、看清倍率和线路，就能避开大部分坑。' },
  { q: '机场会跑路吗？怎么防？', a: '任何机场都有停运的可能。防范方法：先月付，用稳了再年付，不要一次买两三年；选官网写明线路、有公告和工单的机场；准备一个便宜的不限时包当备用。' },
  { q: 'IPLC、IEPL 和中转有什么区别？', a: 'IPLC / IEPL 是机场租用的跨境专线，不经过拥堵的公网国际出口，晚高峰更稳；BGP 中转走公网，便宜但晚上可能变慢。详细原理见本站线路知识教程。' },
  { q: '买机场需要实名吗？', a: '本站收录的机场一般用邮箱注册即可，支付宝、微信或 USDT 付款。注意保护好订阅链接，它相当于你的账号密码。' },
];
const title = `机场选购指南2026：怎么选机场不踩坑（新手必读）`;
const description = `机场选购指南（${UPDATED_MONTH}更新）：怎么选机场不踩坑？从线路（IPLC/IEPL专线与中转）、真实月付价格、流量倍率、付费方式、流媒体与AI解锁、防跑路6个方面教你挑机场，附选购检查清单和符合条件的机场。`;
const schemas = [faqSchema(faq)];
---
<BaseLayout title={title} description={description} structuredData={schemas} breadcrumbs={[{ name: '机场选购指南', path: '/buying-guide/' }]}>
  <div class="h-page">
    <p class="h-eyebrow">更新于 <time datetime={UPDATED}>{UPDATED_LABEL}</time></p>
    <h1>机场选购指南：怎么选机场不踩坑</h1>
    <p class="h-lead">机场很多，质量参差不齐。这篇把选机场要看的 6 件事讲清楚，最后给一张检查清单，买之前对一遍就不容易踩坑。只想快速选，看 <a href="/quick-guide/">一分钟选购指南</a>。</p>
    <Disclosure />

    <section class="h-section">
      <h2>1. 线路：决定晚上卡不卡</h2>
      <p>机场的线路大致分三种：<strong>直连</strong>（最便宜，晚上最容易卡）、<strong>BGP 中转</strong>（性价比高，高峰期可能变慢）、<strong>IPLC / IEPL 专线</strong>（不走拥堵的公网出口，晚上最稳）。日常追剧、开视频会议，建议直接选专线。</p>
      <p class="h-muted">详细原理：<a href="/guide/knowledge-network-lines/">直连、BGP 中转与 IPLC/IEPL 专线的区别</a></p>
    </section>

    <section class="h-section">
      <h2>2. 价格：看真实月付价</h2>
      <p>很多机场首页写“¥7 起”，其实是年付价格除以 12。比较价格时，要看 <strong>月付价</strong>，或者把年付除以 12 再比。本站收录的专线机场，月付入门在 ¥19–¥27 之间。</p>
      <div class="h-table-wrap">
        <table class="h-table">
          <thead><tr><th scope="col">机场</th><th scope="col">月付起步</th><th scope="col">年付最低</th><th scope="col">线路</th></tr></thead>
          <tbody>{AIRPORTS.map((a) => <tr><td><Brand a={a} /></td><td class="h-num">{planPrice(entry(a)!)} · {fmtGB(entry(a)!.traffic)}</td><td class="h-num">{yearly(a)[0] ? planPrice(yearly(a)[0]) : '—'}</td><td>{lineLabel(a)}{!isPremium(a) && <span class="h-tag h-tag-warn" style="margin-left:4px">非专线</span>}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section class="h-section">
      <h2>3. 流量和倍率：别让流量缩水</h2>
      <p>先估算用量：查资料约 50GB、每天刷视频约 150GB、常看 4K 约 300GB、全家用 600GB 以上。再看 <strong>倍率</strong>：1 倍率用 1GB 扣 1GB，2 倍率用 1GB 扣 2GB。同样 150GB，2 倍率节点实际只能用 75GB。</p>
    </section>

    <section class="h-section">
      <h2>4. 付费方式：先月付，再长付</h2>
      <ul class="h-list">
        <li><strong>月付</strong>：第一次买一定选月付，不满意下个月就换。</li>
        <li><strong>年付</strong>：用稳了再买，通常省 20% 左右。</li>
        <li><strong>不限时包</strong>：一次买一包流量，不按月清零，适合偶尔用或当备用。本站收录的机场里有 {AIRPORTS.filter((a) => oneTime(a).length).length} 家提供。</li>
      </ul>
    </section>

    <section class="h-section">
      <h2>5. 流媒体与 AI：看官网写明了什么</h2>
      <p>要用 ChatGPT、看 Netflix，选官网明确写了支持哪些服务的机场，而不是只写“全解锁”的。另外 ChatGPT 不能用香港节点，要选日本、新加坡、美国或台湾节点。详见 <a href="/ai-streaming/">AI 与流媒体解锁</a>。</p>
    </section>

    <section class="h-section">
      <h2>6. 防跑路：别把鸡蛋放一个篮子</h2>
      <ul class="h-list">
        <li>不要一次买两三年，最多先买一年。</li>
        <li>选有公告、工单、维护通知的机场。</li>
        <li>保护好订阅链接，泄露了要在后台重置。</li>
        <li>准备一个便宜的不限时包当备用，主力出问题能马上切换。</li>
      </ul>
    </section>

    <section class="h-section">
      <h2>买机场前的检查清单</h2>
      <div class="h-table-wrap">
        <table class="h-table">
          <thead><tr><th scope="col">检查项</th><th scope="col">靠谱的样子</th><th scope="col">要警惕的样子</th></tr></thead>
          <tbody>{checklist.map((c) => <tr><td><strong>{c.k}</strong></td><td>✅ {c.good}</td><td>⚠️ {c.bad}</td></tr>)}</tbody>
        </table>
      </div>
      <p>对照清单挑好了，看 <a href="/recommend/">机场推荐</a> 或 <a href="/top-10-airports/">十大机场排行榜</a>；买完怎么用，看 <a href="/guide/">使用教程</a>。</p>
    </section>

    <section class="h-section">
      <h2>机场选购常见问题</h2>
      {faq.map((f) => <div class="h-qa"><h3>{f.q}</h3><p>{f.a}</p></div>)}
    </section>
  </div>
</BaseLayout>

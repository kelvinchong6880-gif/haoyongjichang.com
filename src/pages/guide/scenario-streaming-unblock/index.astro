      align-items: stretch;
    }

    .tutorial-article {
      flex: 1;
      min-width: 0;
    }
    
    .article-header {
      text-align: center;
      margin-bottom: 50px;
    }
    
    .ah-meta {
      display: inline-block;
      font-size: 0.9rem;
      font-weight: 600;
      padding: 6px 16px;
      border-radius: 20px;
      margin-bottom: 20px;
    }
    
    .ah-title {
      font-size: 2.5rem;
      color: #0f172a;
      font-weight: 800;
      margin-bottom: 20px;
      line-height: 1.4;
    }
    

  <style is:inline>
.reading-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
  gap: 20px;
}
.reading-link {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 24px;
  background: #fcfcfc;
  border: 1px solid var(--line);
  border-radius: 16px;
  text-decoration: none;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
.reading-icon-wrap {
  flex-shrink: 0;
  width: 48px;
  height: 48px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f4f6;
  color: #6b7280;
}
.reading-text {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.reading-title {
  font-size: 1.05rem;
  font-weight: 600;
  color: #374151;
  line-height: 1.5;
  margin: 0;
  transition: color 0.3s;
}
.reading-action {
  font-size: 0.9rem;
  font-weight: 700;
  color: #2457e6;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  opacity: 0.8;
  transition: all 0.3s;
}
.reading-action span {
  transition: transform 0.2s;
}
.reading-link:hover {
  background: #fff;
  border-color: rgba(36, 87, 230, 0.4);
  box-shadow: 0 8px 30px rgba(36, 87, 230, 0.08);
  transform: translateY(-4px);
}
.reading-link:hover .reading-title {
  color: #2457e6;
}
.reading-link:hover .reading-action {
  opacity: 1;
}
.reading-link:hover .reading-action span {
  transform: translateX(4px);
}
@media (max-width: 768px) {
  .reading-grid { grid-template-columns: 1fr; }
}
</style>


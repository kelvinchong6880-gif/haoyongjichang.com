---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Brand from '../../components/h/Brand.astro';
import Promo from '../../components/h/Promo.astro';
import Disclosure from '../../components/h/Disclosure.astro';
import {
  AIRPORTS, entry, yearly, oneTime, bestValue, perGB, fmtGB, fmtPrice, planPrice, lineLabel, trafficRange, unlockText, isPremium, reviewUrl,
  faqSchema, itemListSchema, UPDATED, UPDATED_LABEL, UPDATED_MONTH, type Airport,
} from '../../data/airports';

const max = (a: Airport) => Math.max(...a.plans.filter((p) => !p.custom && p.billing !== 'One-Time').map((p) => p.traffic));
const subs = [
  { title: '月付最便宜（专线）', rows: AIRPORTS.filter(isPremium).sort((x, y) => entry(x)!.price - entry(y)!.price).slice(0, 5), val: (a: Airport) => `${planPrice(entry(a)!)} · ${fmtGB(entry(a)!.traffic)}`, link: { href: '/cheap-airport/', text: '便宜机场推荐' } },
  { title: '每 GB 最便宜（专线）', rows: AIRPORTS.filter(isPremium).sort((x, y) => perGB(bestValue(x)!) - perGB(bestValue(y)!)).slice(0, 5), val: (a: Airport) => `¥${perGB(bestValue(a)!).toFixed(3)}/GB`, link: { href: '/best-value-airport/', text: '性价比机场' } },
  { title: '大流量', rows: [...AIRPORTS].sort((x, y) => max(y) - max(x)).slice(0, 5), val: (a: Airport) => `最高 ${fmtGB(max(a))}/月`, link: { href: '/best-value-airport/#huge', text: '1TB 以上套餐' } },
  { title: '不限时流量包', rows: AIRPORTS.filter((a) => oneTime(a).length).sort((x, y) => oneTime(x)[0].price - oneTime(y)[0].price).slice(0, 5), val: (a: Airport) => `${planPrice(oneTime(a)[0])} · ${fmtGB(oneTime(a)[0].traffic)}`, link: { href: '/cheap-airport/#no-expiry', text: '不限时包排行' } },
];

const faq = [
  { q: '十大机场排行榜第一名是哪家？', a: `${UPDATED_MONTH}排第一的是 Sogo云：IPLC + IEPL 双专线，¥25/月 150GB 起，9 款套餐里有 4 款不限时包，优惠码 sogo10000。` },
  { q: '机场排名是怎么排的？', a: '综合 4 项：线路（IPLC / IEPL 专线优先）、价格和每 GB 成本、流量档位是否从轻度覆盖到重度、套餐灵活性（年付小包、季付、不限时包）。每月按官网价格重新核对。' },
  { q: '排名靠后的机场就不好吗？', a: '不是。很多机场在单项上排第一，比如跨界云大流量单价最低、无忧链接专线月付最便宜、Flybit 不限时包门槛最低。按自己最在意的那一项看分榜更准。' },
  { q: '为什么小新云便宜却排在最后？', a: '小新云价格最低（¥9.99/月 100GB），但走 BGP 中转不是专线，晚高峰稳定性不如前面的专线机场，所以综合排名靠后，适合预算非常紧的人。' },
];
const title = `十大机场排行榜2026：机场排名前十与推荐理由（10月更新）`;
const description = `2026十大机场排行榜（${UPDATED_MONTH}更新）：Sogo云、微风、飞猫云、Firefly、无忧链接等10家机场综合排名，逐家写明排名理由、月付价格、流量、线路和优惠码，另附月付最便宜、每GB最便宜、大流量、不限时包4个机场排行。`;
const schemas = [itemListSchema(`${UPDATED_MONTH}十大机场排行榜`, AIRPORTS), faqSchema(faq)];
---
<BaseLayout title={title} description={description} structuredData={schemas} breadcrumbs={[{ name: '十大机场排行榜', path: '/top-10-airports/' }]}>
  <div class="h-page">
    <p class="h-eyebrow">更新于 <time datetime={UPDATED}>{UPDATED_LABEL}</time></p>
    <h1>十大机场排行榜 2026：机场排名前十</h1>
    <p class="h-lead">按线路、价格、流量档位和套餐灵活性，给 10 家机场排出前十名。每家都写了排名理由；只在意价格或流量的话，直接看下面的 4 个单项排行。</p>
    <Disclosure />

    <section class="h-section">
      <h2>{UPDATED_MONTH}十大机场排名</h2>
      <div class="h-table-wrap">
        <table class="h-table">
          <thead><tr><th scope="col">排名</th><th scope="col">机场</th><th scope="col">排名理由</th><th scope="col">月付起步</th><th scope="col">每月流量</th><th scope="col">线路</th><th scope="col">解锁</th><th scope="col"><span style="position:absolute;left:-9999px">操作</span></th></tr></thead>
          <tbody>
            {AIRPORTS.map((a, i) => (
              <tr class={i === 0 ? 'is-hl' : ''}>
                <td><span class={`h-rank ${i === 0 ? 'h-rank-1' : ''}`}>{i + 1}</span></td>
                <td><Brand a={a} /></td>
                <td style="min-width:260px">{a.verdict}</td>
                <td class="h-num"><span class="h-price">{fmtPrice(entry(a)!.price)}</span> / {fmtGB(entry(a)!.traffic)}</td>
                <td class="h-num">{trafficRange(a)}</td>
                <td>{lineLabel(a)}{!isPremium(a) && <span class="h-tag h-tag-warn" style="margin-left:4px">非专线</span>}</td>
                <td>{unlockText(a)}</td>
                <td><a class="h-btn h-btn-sm" href={a.aff} target="_blank" rel="nofollow sponsored noopener">官网</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="h-section">
      <h2>机场单项排行</h2>
      <div class="h-grid">
        {subs.map((s) => (
          <div class="h-box">
            <h3>{s.title}</h3>
            <ol class="h-list" style="margin-bottom:8px">{s.rows.map((a) => <li><a href={reviewUrl(a)}>{a.name}</a>：<span class="h-num">{s.val(a)}</span></li>)}</ol>
            <a href={s.link.href}>{s.link.text} →</a>
          </div>
        ))}
      </div>
    </section>

    <section class="h-section">
      <h2>前十名逐一点评</h2>
      {AIRPORTS.map((a, i) => {
        const y = yearly(a)[0]; const o = oneTime(a);
        return (
          <div class="h-box" style="margin-bottom:12px" id={a.slug}>
            <div class="h-actions" style="margin-bottom:6px">
              <span class={`h-rank ${i === 0 ? 'h-rank-1' : ''}`}>{i + 1}</span>
              <h3 style="margin:0"><a href={reviewUrl(a)}>{a.name}</a></h3>
              {!isPremium(a) && <span class="h-tag h-tag-warn">非专线</span>}
            </div>
            <p style="margin:0 0 6px"><strong>排名理由：</strong>{a.verdict}。适合{a.bestFor}。</p>
            <p class="h-muted" style="margin:0 0 10px">月付 {planPrice(entry(a)!)} 起{y ? ` · 年付 ${planPrice(y)} 起` : ''}{o.length ? ` · 不限时包 ${fmtPrice(o[0].price)} 起` : ''} · {lineLabel(a)} · {a.devices}</p>
            <div class="h-actions">
              <a class="h-btn h-btn-sm" href={a.aff} target="_blank" rel="nofollow sponsored noopener">前往官网 ↗</a>
              <a href={reviewUrl(a)}>{a.name}怎么样</a>
              <Promo code={a.promo} />
            </div>
          </div>
        );
      })}
    </section>

    <section class="h-section">
      <h2>排名方法</h2>
      <ul class="h-list">
        <li><strong>线路</strong>：IPLC / IEPL 专线优先，双专线更高；中转或官网未写线路的排在后面。</li>
        <li><strong>价格</strong>：比较真实月付价，年付折成每月，再算每 GB 价格。</li>
        <li><strong>流量覆盖</strong>：从 50GB 到 1TB 以上都有档位的加分。</li>
        <li><strong>套餐灵活性</strong>：有年付小包、季付、不限时包的加分。</li>
      </ul>
    </section>

    <section class="h-section">
      <h2>十大机场排行榜常见问题</h2>
      {faq.map((f) => <div class="h-qa"><h3>{f.q}</h3><p>{f.a}</p></div>)}
    </section>
  </div>
</BaseLayout>
